{
  "schemaVersion": 1,
  "id": "quickelytra",
  "version": "${version}",
  "name": "Quick Elytra",
  "description": "Adds useful QOL hotkeys, such as an elytra swap hotkey and quick totem equip hotkey. Also includes an optional automatic elytra-swap functionality.",
  "authors": ["glitchifyed"],
  "contact": {
    "repo": "https://github.com/glitchifyed/quick_hotkeys",
    "homepage": "https://modrinth.com/mod/quickelytra",
    "sources": "https://github.com/glitchifyed/quick_hotkeys",
    "issues": "https://github.com/glitchifyed/quick_hotkeys/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/quickelytra/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.glitchifyed.quickelytra.QuickElytra"
    ],
    "client": [
      "net.glitchifyed.quickelytra.client.QuickElytraClient"
    ],
    "modmenu": [
      "net.glitchifyed.quickelytra.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "quickelytra.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.2",
    "java": ">=25",
    "yet_another_config_lib_v3": ">=3.9.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
